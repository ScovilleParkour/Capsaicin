From: Melody Belle <melody@meluhdy.dev>
Date: Wed, 29 Apr 2026 15:41:11 -0400
Subject: [PATCH] [PATCH] 1.12 Player Hitboxes


diff --git a/net/minecraft/server/network/ServerGamePacketListenerImpl.java b/net/minecraft/server/network/ServerGamePacketListenerImpl.java
index 5c4dacec63cf40676ffc3cd28364377ae5408e35..942e74f378259e1e4edee14bd0e30f1896f04be7 100644
--- a/net/minecraft/server/network/ServerGamePacketListenerImpl.java
+++ b/net/minecraft/server/network/ServerGamePacketListenerImpl.java
@@ -328,7 +328,7 @@ public class ServerGamePacketListenerImpl
         this.player = player;
         player.connection = this;
         player.getTextFilter().join();
-        this.signedMessageDecoder = SignedMessageChain.Decoder.unsigned(player.getUUID(), server::enforceSecureProfile);
+        this.signedMessageDecoder = SignedMessageChain.Decoder.unsigned(player.getUUID(), () -> false);
         this.chatMessageChain = new FutureChain(server.chatExecutor); // CraftBukkit - async chat
         this.tickEndEvent = new io.papermc.paper.event.packet.ClientTickEndEvent(player.getBukkitEntity()); // Paper - add client tick end event
         this.playerGameConnection =  new io.papermc.paper.connection.PaperPlayerGameConnection(this); // Paper
diff --git a/net/minecraft/world/entity/Avatar.java b/net/minecraft/world/entity/Avatar.java
index 41841b4958d21168df8a10b4f5b9e79ea8c3fc48..ad00f212d8b8d3e97a1530742ba5a16d96b0d721 100644
--- a/net/minecraft/world/entity/Avatar.java
+++ b/net/minecraft/world/entity/Avatar.java
@@ -17,7 +17,7 @@ public class Avatar extends LivingEntity {
     private static final float CROUCH_BB_HEIGHT = 1.5F;
     private static final float SWIMMING_BB_WIDTH = 0.6F;
     public static final float SWIMMING_BB_HEIGHT = 0.6F;
-    protected static final EntityDimensions STANDING_DIMENSIONS = EntityDimensions.scalable(0.6F, 1.8F)
+    protected static final EntityDimensions STANDING_DIMENSIONS = EntityDimensions.scalable(0.6F, 1.0F)
         .withEyeHeight(1.62F)
         .withAttachments(EntityAttachments.builder().attach(EntityAttachment.VEHICLE, DEFAULT_VEHICLE_ATTACHMENT));
     protected static final Map<Pose, EntityDimensions> POSES = ImmutableMap.<Pose, EntityDimensions>builder()
@@ -28,7 +28,7 @@ public class Avatar extends LivingEntity {
         .put(Pose.SPIN_ATTACK, EntityDimensions.scalable(0.6F, 0.6F).withEyeHeight(0.4F))
         .put(
             Pose.CROUCHING,
-            EntityDimensions.scalable(0.6F, 1.5F)
+            EntityDimensions.scalable(0.6F, 1.0F)
                 .withEyeHeight(1.27F)
                 .withAttachments(EntityAttachments.builder().attach(EntityAttachment.VEHICLE, DEFAULT_VEHICLE_ATTACHMENT))
         )

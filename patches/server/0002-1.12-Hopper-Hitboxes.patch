+    VoxelShape INSIDE = Block.box(2.0D, 10.0D, 2.0D, 14.0D, 16.0D, 14.0D);
     VoxelShape ABOVE = Block.box(0.0D, 16.0D, 0.0D, 16.0D, 32.0D, 16.0D);
     VoxelShape SUCK = Shapes.or(INSIDE, ABOVE);
 
